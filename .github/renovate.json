{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":prHourlyLimit2",
    ":prConcurrentLimit10",
    "helpers:pinGitHubActionDigests"
  ],
  "assigneesFromCodeOwners": true,
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "timezone": "America/Chicago",
  "ignorePaths": [
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/testdata/**"
  ],
  "schedule": [
    "before 06:00 on Monday"
  ],
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "bump",
  "rebaseWhen": "behind-base-branch",
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": "0 days"
  },
  "packageRules": [
    {
      "description": "Runtime Go dependencies use the deps type so they land in the Dependencies changelog section and still trigger a patch release. Scope is the dep being updated.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "require"
      ],
      "semanticCommitType": "deps",
      "semanticCommitScope": "{{depName}}"
    },
    {
      "description": "Indirect Go deps are noise; group them. They're external deps, so build(deps).",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "groupName": "go indirect dependencies",
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Group golang.org/x/* together - they version-lockstep.",
      "matchManagers": [
        "gomod"
      ],
      "groupName": "golang.org/x",
      "matchPackageNames": [
        "golang.org/x/{/,}**"
      ]
    },
    {
      "description": "Group hashicorp/hcl + zclconf/go-cty - they release in lockstep. go-cty is indirect, so force the deps type to keep the group's commit type consistent.",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/hashicorp/hcl/v2",
        "github.com/zclconf/go-cty"
      ],
      "groupName": "hcl + cty",
      "semanticCommitType": "deps",
      "semanticCommitScope": "{{depName}}"
    },
    {
      "description": "GitHub Actions: pin to commit SHA, group all together, ship as ci(deps).",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Auto-merge patch + digest + pin updates for GitHub Actions once CI is green.",
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin"
      ],
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Auto-merge patch and digest gomod updates.",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Auto-merge non-major vulnerability fixes ASAP; majors still require review.",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest",
        "pin"
      ],
      "isVulnerabilityAlert": true,
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Major bumps deserve a deliberate review.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "breaking"
      ]
    }
  ],
  "customManagers": [
    {
      "description": "Keep `pip install <pkg>==<version>` pins in workflows fresh (e.g. zensical).",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "pip install (?<depName>[A-Za-z0-9._-]+)==(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "pypi"
    }
  ]
}
